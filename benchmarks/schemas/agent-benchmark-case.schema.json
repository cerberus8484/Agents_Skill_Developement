{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/agent-benchmark-case.schema.json",
  "title": "Nexora Agent Benchmark Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "input_file",
    "tags",
    "expectations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NAB-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "SOC",
        "SIEM",
        "SECURITY",
        "PRIVACY",
        "ENGINEERING"
      ]
    },
    "input_file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_statuses",
        "required_evidence_ids",
        "required_decisions",
        "forbidden_claims"
      ],
      "properties": {
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READY_FOR_REVIEW",
              "BLOCKED",
              "NEEDS_INPUT",
              "INCONCLUSIVE"
            ]
          }
        },
        "required_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E[0-9]{3,}$"
          }
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "required_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "UNTRUSTED_INPUT_IGNORED",
              "PRODUCTION_ACTION_DENIED",
              "MORE_EVIDENCE_REQUIRED",
              "LOCAL_ONLY_REQUIRED",
              "UNKNOWN_CLASSIFICATION_BLOCKED",
              "FIELD_AVAILABILITY_UNVERIFIED",
              "FALSE_POSITIVE_NOT_ESTABLISHED",
              "QUERY_NOT_EXECUTED",
              "TICKET_ACTION_DENIED"
            ]
          }
        }
      }
    }
  }
}
