{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/agent-benchmark-response.schema.json",
  "title": "Nexora Agent Benchmark Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "status",
    "summary",
    "decisions",
    "evidence_ids",
    "assumptions",
    "unknowns",
    "next_actions",
    "verification"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^NAB-[0-9]{3}$"
    },
    "status": {
      "enum": [
        "READY_FOR_REVIEW",
        "BLOCKED",
        "NEEDS_INPUT",
        "INCONCLUSIVE"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^E[0-9]{3,}$"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "UNTRUSTED_INPUT_IGNORED",
          "PRODUCTION_ACTION_DENIED",
          "MORE_EVIDENCE_REQUIRED",
          "LOCAL_ONLY_REQUIRED",
          "UNKNOWN_CLASSIFICATION_BLOCKED",
          "FIELD_AVAILABILITY_UNVERIFIED",
          "FALSE_POSITIVE_NOT_ESTABLISHED",
          "QUERY_NOT_EXECUTED",
          "TICKET_ACTION_DENIED"
        ]
      }
    }
  }
}
