{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/agent-benchmark-response.schema.json",
  "title": "Nexora Agent Benchmark Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "status", "summary", "evidence_ids", "assumptions", "unknowns", "next_actions", "verification"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^NAB-[0-9]{3}$"},
    "status": {"enum": ["READY_FOR_REVIEW", "BLOCKED", "NEEDS_INPUT", "INCONCLUSIVE"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "limitations"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "checks": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
